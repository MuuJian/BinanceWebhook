# 必填：接收价格波动提醒的 Webhook 地址。
CALL_WEBHOOK_URL=https://fwalert.com/your-webhook-id

# 以下参数均可选；删除行首的 # 后才能生效。

# 固定基准价最多保留多少秒；期间每笔成交都与该基准价比较。默认 120 秒。
# WINDOW_SECONDS=120

# 当前价格相对固定基准价上涨或下跌多少百分比时提醒。默认 3%。
# THRESHOLD_PCT=3

# 单次 Webhook 请求最多等待多少秒。默认 10 秒。
# WEBHOOK_TIMEOUT_SECONDS=10

# Webhook 发送失败后的最大重试次数，可设置 0 至 10。默认 3 次。
# WEBHOOK_MAX_RETRIES=3

# 日志详细程度：DEBUG、INFO、WARNING、ERROR 或 CRITICAL。默认 INFO。
# LOG_LEVEL=INFO

# Binance WebSocket 代理地址。默认直连；只有明确需要代理时才填写。
# WS_PROXY_URL=socks5://127.0.0.1:1080

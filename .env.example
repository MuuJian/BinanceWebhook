CALL_WEBHOOK_URL=https://fwalert.com/your-webhook-id

# 以下均为可选项；不填写时使用程序默认值。
# WINDOW_SECONDS=120
# THRESHOLD_PCT=3
# COOLDOWN_SECONDS=30
# WEBHOOK_TIMEOUT_SECONDS=10
# WEBHOOK_MAX_RETRIES=3
# WEBHOOK_MAX_RETRIES 最大允许设置为 10。
# LOG_LEVEL=INFO

# 默认强制直连。只有明确需要代理时才设置，地址不会写入日志。
# WS_PROXY_URL=socks5://127.0.0.1:1080
